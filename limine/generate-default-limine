#!/usr/bin/env bash

set -euo pipefail

die() {
    echo "ERROR: $*" >&2
    exit 1
}

first_value() {
    awk 'NF { print $1; exit }'
}

block_value() {
    local field="$1"
    local dev="$2"

    [[ -b "$dev" ]] || return 0
    lsblk -no "$field" "$dev" 2>/dev/null | first_value
}

strip_findmnt_source() {
    local source="$1"
    # findmnt prints Btrfs subvolumes as /dev/...[/@]. Keep only the block dev.
    printf '%s\n' "${source%%\[*}"
}

dm_block_for_mapper() {
    local mapper_name="$1"
    local root_source="$2"
    local block=""

    if [[ "$root_source" == /dev/dm-* ]]; then
        basename "$root_source"
        return 0
    fi

    if [[ -L "$root_source" ]]; then
        block="$(basename "$(readlink -f "$root_source")")"
        [[ "$block" == dm-* ]] && {
            printf '%s\n' "$block"
            return 0
        }
    fi

    for dm in /sys/class/block/dm-*; do
        [[ -e "$dm/dm/name" ]] || continue
        if [[ "$(cat "$dm/dm/name" 2>/dev/null)" == "$mapper_name" ]]; then
            basename "$dm"
            return 0
        fi
    done
}

backing_device_for_mapper() {
    local mapper_name="$1"
    local root_source="$2"
    local dm_block slave

    dm_block="$(dm_block_for_mapper "$mapper_name" "$root_source" || true)"
    if [[ -n "$dm_block" ]]; then
        for slave in /sys/class/block/"$dm_block"/slaves/*; do
            [[ -e "$slave" ]] || continue
            printf '/dev/%s\n' "$(basename "$(readlink -f "$slave")")"
            return 0
        done
    fi

    cryptsetup status "$mapper_name" 2>/dev/null \
        | awk '/^[[:space:]]*device:/ { print $2; exit }'
}

current_cmdline_value() {
    local key="$1"
    local token

    for token in $(cat /proc/cmdline 2>/dev/null || true); do
        case "$token" in
            "$key"=*)
                printf '%s\n' "${token#*=}"
                return 0
                ;;
        esac
    done
}

subvol_rootflag() {
    local opts="$1"
    local opt subvol=""

    IFS=',' read -ra parts <<< "$opts"
    for opt in "${parts[@]}"; do
        case "$opt" in
            subvol=*)
                subvol="${opt#subvol=}"
                subvol="${subvol#/}"
                ;;
        esac
    done

    [[ -n "$subvol" ]] && printf 'rootflags=subvol=%s\n' "$subvol"
}

root_source="$(strip_findmnt_source "$(findmnt -no SOURCE /)")"
root_fstype="$(findmnt -no FSTYPE /)"
root_opts="$(findmnt -no OPTIONS /)"

[[ -n "$root_source" ]] || die "could not detect root source with findmnt"
[[ -n "$root_fstype" ]] || die "could not detect root filesystem type with findmnt"

profile="normal"
root_args=()

if [[ "$root_source" == /dev/mapper/* || "$root_source" == /dev/dm-* ]]; then
    mapper_name="${root_source#/dev/mapper/}"
    [[ "$root_source" == /dev/dm-* ]] && mapper_name="$(cat "/sys/class/block/${root_source##*/}/dm/name" 2>/dev/null || true)"
    [[ -n "$mapper_name" ]] || die "root is a dm device but mapper name could not be detected"

    backing_device="$(backing_device_for_mapper "$mapper_name" "$root_source" || true)"
    partuuid=""
    [[ -n "$backing_device" ]] && partuuid="$(block_value PARTUUID "$backing_device" || true)"

    # If detection is running from an unusual environment, preserve a known-good
    # cryptdevice= value from the current kernel command line as a fallback.
    cryptdevice="$(current_cmdline_value cryptdevice || true)"
    if [[ -z "$cryptdevice" ]]; then
        [[ -n "$partuuid" ]] || die "encrypted root detected, but backing PARTUUID is unknown"
        cryptdevice="PARTUUID=${partuuid}:${mapper_name}"
    fi

    profile="encrypted"
    [[ "$root_fstype" == "btrfs" ]] && profile="encrypted-btrfs"

    root_args+=("cryptdevice=${cryptdevice}")
    root_args+=("root=/dev/mapper/${mapper_name}")
else
    root_uuid="$(block_value UUID "$root_source" || true)"
    root_partuuid="$(block_value PARTUUID "$root_source" || true)"

    if [[ -n "$root_uuid" ]]; then
        root_args+=("root=UUID=${root_uuid}")
    elif [[ -n "$root_partuuid" ]]; then
        root_args+=("root=PARTUUID=${root_partuuid}")
    else
        die "normal root detected, but UUID/PARTUUID is unknown for $root_source"
    fi
fi

root_args+=("zswap.enabled=0")

if [[ "$root_fstype" == "btrfs" ]]; then
    rootflag="$(subvol_rootflag "$root_opts" || true)"
    [[ -n "$rootflag" ]] && root_args+=("$rootflag")
fi

root_args+=("rw")
root_args+=("rootfstype=${root_fstype}")

cat <<EOF
# Auto-generated by limine/generate-default-limine.
# Detected profile: ${profile}
# Detected root: ${root_source} (${root_fstype})
# Do not copy this file between machines without regenerating it.
#TARGET_OS_NAME="Omarchy"
TARGET_OS_NAME="Sohaib"

ESP_PATH="/boot"

KERNEL_CMDLINE[default]+="${root_args[*]}"
# Enable Omarchy/Plymouth graphical disk unlock or boot splash.
KERNEL_CMDLINE[default]+="quiet splash loglevel=0 systemd.show_status=false rd.udev.log_level=0 vt.global_cursor_default=0"

ENABLE_UKI=yes
CUSTOM_UKI_NAME="omarchy"

ENABLE_LIMINE_FALLBACK=yes

# Find and add other bootloaders
FIND_BOOTLOADERS=yes

BOOT_ORDER="*, *fallback, Snapshots"

MAX_SNAPSHOT_ENTRIES=5

SNAPSHOT_FORMAT_CHOICE=5
EOF
