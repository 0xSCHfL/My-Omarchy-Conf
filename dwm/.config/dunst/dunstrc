[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 300
    origin = top-right
    offset = 10x10
    notification_limit = 5
    progress_bar = true
    transparency = 10
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#81857E"
    gap_size = 5
    font = monospace 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    min_icon_size = 32
    max_icon_size = 128
    corner_radius = 8
    timeout = 5

[urgency_low]
    background = "#0f1011"
    foreground = "#9b9993"
    timeout = 5

[urgency_normal]
    background = "#0f1011"
    foreground = "#dedbd2"
    timeout = 5

[urgency_critical]
    background = "#0f1011"
    foreground = "#dedbd2"
    frame_color = "#596464"
    timeout = 0
