#!/bin/sh

# Monitors
xrandr --output eDP-1 --auto --output HDMI-1 --auto --right-of eDP-1 --primary

# Fix Backspace key (remap keycode 22 to XK_BackSpace)
xmodmap -e "keycode 22 = BackSpace BackSpace BackSpace BackSpace"

# Wallpaper — restore last pywal wallpaper, fall back to default
if [ -f ~/.cache/wal/wal ]; then
    feh --bg-scale "$(cat ~/.cache/wal/wal)" &
    [ -f ~/.cache/wal/colors.Xresources ] && xrdb -merge ~/.cache/wal/colors.Xresources
else
    ~/.config/i3/scripts/wallpaper-set.sh &
fi

# Load pywal colors into Xresources so st picks them up
[ -f ~/.cache/wal/colors.Xresources ] && xrdb -merge ~/.cache/wal/colors.Xresources

# Compositor
picom --daemon &

# Notifications
dunst &

# Status bar
~/.local/bin/dwm-statusbar &

# Network manager tray
nm-applet &

# Policykit authentication agent
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Clipboard sync (PRIMARY ↔ CLIPBOARD)
autocutsel -fork &

# Clipboard history daemons
~/.local/bin/dwm-cliphist &
~/.local/bin/dwm-imgclipwatch &

# File manager daemon
thunar --daemon &>/dev/null &

# Screen locker
xss-lock --transfer-sleep-lock -- i3lock --nofork &

# Clipboard manager
copyq &

# Screenshot tool
flameshot &

# XDG autostart
dex --autostart --environment dwm &

exec dwm
