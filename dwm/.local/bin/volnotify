#!/bin/bash
case $1 in
  up)   pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
  down) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
  mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
esac

vol=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '/Volume/{printf "%d", $5}')
mute=$(pactl get-sink-mute @DEFAULT_SINK@ | grep -q "yes" && echo 1 || echo 0)

pkill -RTMIN+6 dwmblocks 2>/dev/null

PIPE="/tmp/xob-vol"
[ -p "$PIPE" ] || mkfifo "$PIPE"

if [ "$mute" = 1 ]; then
  echo "${vol}!" > "$PIPE"
else
  echo "$vol" > "$PIPE"
fi
