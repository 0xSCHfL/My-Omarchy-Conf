#!/bin/sh

# ueberzugpp stuff
case "$(uname -a)" in
    *Darwin*) UEBERZUG_TMP_DIR="$TMPDIR" ;;
    *) UEBERZUG_TMP_DIR="/tmp" ;;
esac

cleanup() {
    ueberzugpp cmd -s "$SOCKET" -a exit
}
trap cleanup HUP INT QUIT TERM EXIT

UB_PID_FILE="$UEBERZUG_TMP_DIR/.$(uuidgen)"
ueberzugpp layer --no-stdin --silent --pid-file "$UB_PID_FILE"
while [ ! -s "$UB_PID_FILE" ]; do sleep 0.05; done
UB_PID=$(cat "$UB_PID_FILE")

export SOCKET="$UEBERZUG_TMP_DIR"/ueberzugpp-"$UB_PID".socket

# fzf optional settings:
# first argument: directory
# second argument: preset options
# third argument: any other options
# example using wallpapermenu opts: 
# fzfub ~/pics w --tac

ROOT="${1:-$PWD}"

case $2 in
		*w) # wallpapermenu options
				FZFARGS='ctrl-t:execute-silent(wallpapermenu {} tendency),ctrl-f:execute-silent(wallpapermenu {} flare),ctrl-d:execute-silent(wallpapermenu {} dim),ctrl-g:execute-silent(wallpapermenu {} grove),ctrl-w:execute-silent(wallpapermenu {}),ctrl-e:become(gimp {+} > /dev/null 2>&1)'
				ILABEL='·.·★⋆⁺₊⋆·.·★⋆⁺₊⋆𝖜𝖆𝖑𝖑𝖕𝖆𝖕𝖊𝖗 𝖒𝖊𝖓𝖚⋆⁺₊⋆★·.·⋆⁺₊⋆★·.·'
				LABEL='[ᴄᴛʀʟ 𝐰·ᴘʏᴡᴀʟ 𝐝·ᴅɪᴍ 𝐟·ғʟᴀʀᴇ 𝐠·ɢʀᴏᴠᴇ 𝐭·ᴛᴇɴᴅᴇɴᴄʏ]' ;;
		*m) # ₊⊹ɪᴍɢᴍɢᴋ⊹₊ options
				FZFARGS='ctrl-r:reload(find $PICS -type f | sort -V),ctrl-e:execute-silent(imgmgk stripexif {})+reload(find $PICS -type f | sort -V),alt-j:execute-silent(imgmgk jpg {})+reload(find $PICS -type f | sort -V),alt-p:execute-silent(imgmgk png {})+reload(find $PICS -type f | sort -V),ctrl-d:execute-silent(rm -f {+})+reload(find $PICS -type f | sort -V),ctrl-s:execute-silent(imgmgk scale {+})+reload(find $PICS -type f | sort -V),ctrl-b:execute-silent(imgmgk bw {+})+reload(find $PICS -type f | sort -V),ctrl-w:execute-silent(imgmgk wm {+})+reload(find $PICS -type f | sort -V),ctrl-g:become(gimp {+} > /dev/null 2>&1),ctrl-t:execute-silent(imgmgk transparency {+})+reload(find $PICS -type f | sort -V),ctrl-f:execute-silent(imgmgk flip {+})+reload(find $PICS -type f | sort -V),ctrl-v:execute-silent(imgmgk vflip {+})+reload(find $PICS -type f | sort -V),ctrl-l:execute-silent(imgmgk border {+})+reload(find $PICS -type f | sort -V),ctrl-h:execute-silent(imgmgk wborder {+})+reload(find $PICS -type f | sort -V),alt-w:execute-silent($HOME/.config/i3/scripts/wallpaper/wallpaper-set.sh {})'
				ILABEL="[sᴘᴀᴄᴇ: ᴍᴜʟᴛɪ-sᴇʟᴇᴄᴛ | ᴄᴛʀʟ: ᴅ ᴅᴇʟ, ᴇ ᴇxɪғ, ʙ ʙ&ᴡ, ᴡ ᴡᴛʀᴍᴀʀᴋ]"
				LABEL="𝐠·➡ɢɪᴍᴘ 𝐭·ᴛʀᴀɴsᴘᴀʀᴇɴᴛ 𝐟/𝐯·ғʟɪᴘ 𝐥·ʙʟᴋ 𝐡·ᴡʜᴛᴇ ʙᴏʀᴅʀ | sᴘᴀᴄᴇ: ᴛᴏɢɢʟᴇ" ;;
		*c) # cliphist options
				ILABEL="ᴄʟɪᴘʜɪsᴛ: ᴇɴᴛᴇʀ/ᴄᴛʀʟ-c: ᴄᴏᴘʏ | sᴘᴀᴄᴇ: sᴇʟᴇᴄᴛ"
				LABEL="[sᴘᴀᴄᴇ: ᴛᴏɢɢʟᴇ ᴍᴜʟᴛɪ-sᴇʟᴇᴄᴛ | ᴄᴛʀʟ-d: ᴅᴇʟ ᴇʟᴇᴄᴛᴇᴅ | ᴄᴛʀʟ-g: ɢɪᴍᴘ | ᴛ: ᴛʀᴀɴsᴘᴀʀᴇɴᴛ]"
				FZFARGS="space:toggle,enter:execute-silent(sh -c 'i3-imgcliphist-copy \"\$1\"' sh {} )+abort,ctrl-c:execute-silent(sh -c 'i3-imgcliphist-copy \"\$1\"' sh {} )+abort,ctrl-t:execute-silent(imgmgk transparencyrecopy {+}),ctrl-g:become(gimp {+} > /dev/null 2>&1),ctrl-d:execute-silent(rm -f {+})+reload(find \"$ROOT\" -type f | sort -V)" ;;
		*) FZFARGS='ctrl-d:execute(rm -i {} && notify-send {} deleted)' ;; # normal options
esac

# run fzf with preview and given vars
fzf --walker-root=${1:-$PWD} $3 -m --bind "$FZFARGS" --style ${STYLE:-full} --reverse --delimiter / --with-nth -1 --preview-border --preview-label "$LABEL" --input-label "$ILABEL" --preview="ueberzugpp cmd -s $SOCKET -i fzfpreview -a add \
                            -x \$FZF_PREVIEW_LEFT -y \$FZF_PREVIEW_TOP \
                            --max-width \$FZF_PREVIEW_COLUMNS --max-height \$FZF_PREVIEW_LINES \
                            -f {} || bat --style=plain --color=always {}"

ueberzugpp cmd -s "$SOCKET" -a exit
