#!/bin/bash
# Post-pywal hook — runs after wal sets wallpaper and generates colors

WAL_COLORS="$HOME/.cache/wal/colors"
[ "$1" = "--from-fzf" ] && FROM_FZF=1 || FROM_FZF=0

[ -f "$WAL_COLORS" ] || exit 1

# Generate themed dunst config from template
DUNST_TEMPLATE="$HOME/.config/dunst/dunstrc"
if [ -f "$DUNST_TEMPLATE" ]; then
  sed -i \
    -e "s|background = \".*\"|background = \"$(sed -n '1p' $WAL_COLORS)\"|" \
    -e "s|foreground = \".*\"|foreground = \"$(sed -n '7p' $WAL_COLORS)\"|" \
    "$DUNST_TEMPLATE" 2>/dev/null
fi

# Reload X resources
xrdb -merge "$HOME/.cache/wal/colors.Xresources" 2>/dev/null
[ -f "$HOME/.cache/wal/xrdb_extra" ] && xrdb -merge "$HOME/.cache/wal/xrdb_extra" 2>/dev/null

# Write DWM color Xresources from pywal palette and restart DWM to pick them up
# Only when DWM is actually managing the current display (not i3/hyprland)
if [ -f "$HOME/.cache/wal/colors.sh" ] && pgrep -x dwm | xargs -I{} grep -q "DISPLAY=$DISPLAY" /proc/{}/environ 2>/dev/null; then
    . "$HOME/.cache/wal/colors.sh"
    xrdb -merge <<EOF
dwm.normbgcolor:     $background
dwm.normfgcolor:     $color7
dwm.normbordercolor: $color8
dwm.selbgcolor:      $color4
dwm.selfgcolor:      $color0
dwm.selbordercolor:  $color4
dwm.sepcolor:        $color8
dwm.iconcolor:       $color4
dwm.valcolor:        $foreground
dwm.warncolor:       $color3
EOF
    [ $FROM_FZF -eq 0 ] && pkill -HUP dwm 2>/dev/null
fi

# Refresh st terminals (reload colors from X resources)
# Skip if called from inside fzf — USR1 causes st to inject ESC into fzf's input, aborting it
[ $FROM_FZF -eq 0 ] && pkill -USR1 st 2>/dev/null

# Restart dunst
pkill dunst 2>/dev/null
dunst &>/dev/null &

notify-send "Wallpaper set" "Colorscheme updated"
