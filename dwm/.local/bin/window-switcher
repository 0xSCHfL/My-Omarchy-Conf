#!/bin/bash
# Window switcher + keybindings viewer

KEYBINDINGS_ENTRY="  Show keybindings"

windows=$(xdotool search --onlyvisible --name "" 2>/dev/null | while read id; do
  name=$(xdotool getwindowname "$id" 2>/dev/null | tr '\n' ' ' | sed 's/^ *//;s/ *$//')
  class=$(xdotool getwindowclassname "$id" 2>/dev/null | tr '\n' ' ')
  [ -n "$name" ] && printf "%-50s  [%s]\n" "${name:0:50}" "${class% }"
done | sort -u)

choice=$(printf "%s\n%s" "$KEYBINDINGS_ENTRY" "$windows" | dmenu -i -l 15 -p 'Switch to:')

if [ "$choice" = "$KEYBINDINGS_ENTRY" ]; then
  dwm-keys
elif [ -n "$choice" ]; then
  name=$(echo "$choice" | sed 's/  \[.*\]$//' | sed 's/[[:space:]]*$//')
  xdotool search --name "$name" 2>/dev/null | head -1 | xargs -I {} xdotool windowactivate {} 2>/dev/null
fi
