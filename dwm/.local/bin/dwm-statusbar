#!/bin/bash

# Color scheme bytes (1-indexed into DWM colors[] array)
SEP=$'\x03'   # dim gray  — separators / secondary text
I=$'\x04'     # frost blue — icons
V=$'\x05'     # snow white — values
W=$'\x06'     # aurora yellow — warnings

S="${SEP} | ${V}"   # separator between modules

PREV_IDLE=0
PREV_TOTAL=0

get_cpu_usage() {
    read -r _ user nice system idle iowait irq softirq _ < /proc/stat
    total=$((user + nice + system + idle + iowait + irq + softirq))
    if [ "$PREV_TOTAL" -gt 0 ] && [ "$((total - PREV_TOTAL))" -gt 0 ]; then
        didle=$((idle - PREV_IDLE))
        dtotal=$((total - PREV_TOTAL))
        cpu=$(( (dtotal - didle) * 100 / dtotal ))
    else
        cpu=0
    fi
    PREV_IDLE=$idle
    PREV_TOTAL=$total
    printf "%d" "$cpu"
}

get_cpu_temp() {
    sensors 2>/dev/null | awk '
        /^(Tdie|Package id|Core 0|CPU|temp1)/ {
            gsub(/[+°C]/, "")
            for (i=1; i<=NF; i++)
                if ($i ~ /^[0-9]+(\.[0-9]+)?$/) { gsub(/\..*/, "", $i); print $i; exit }
        }'
}

get_volume() {
    local vol muted icon
    if command -v pamixer &>/dev/null; then
        muted=$(pamixer --get-mute 2>/dev/null)
        vol=$(pamixer --get-volume 2>/dev/null)
        [ "$muted" = "true" ] && echo "${I}󰖁${SEP} mute" && return
    elif command -v pactl &>/dev/null; then
        vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oP '\d+(?=%)' | head -1)
        muted=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -o 'yes')
        [ "$muted" = "yes" ] && echo "${I}󰖁${SEP} mute" && return
    else
        vol=$(amixer get Master 2>/dev/null | grep -oP '\[\d+%\]' | head -1 | tr -d '[]%')
        local off=$(amixer get Master 2>/dev/null | grep -oP '\[off\]' | head -1)
        [ "$off" = "[off]" ] && echo "${I}󰖁${SEP} mute" && return
    fi
    [ -z "$vol" ] && echo "${I}󰖁${V} ?" && return
    if   [ "$vol" -ge 70 ]; then icon="󰕾"
    elif [ "$vol" -ge 30 ]; then icon="󰖀"
    else icon="󰕿"; fi
    echo "${I}${icon}${V} ${vol}%"
}

get_battery() {
    local bat_path
    for p in /sys/class/power_supply/BAT{0,1,2}; do
        [ -d "$p" ] && bat_path="$p" && break
    done
    [ -z "$bat_path" ] && return

    local cap status icon
    cap=$(cat "$bat_path/capacity" 2>/dev/null)
    status=$(cat "$bat_path/status" 2>/dev/null)

    if   [ "$status" = "Charging" ];    then icon="󰂄"
    elif [ "${cap:-0}" -ge 90 ];        then icon="󰁹"
    elif [ "${cap:-0}" -ge 70 ];        then icon="󰂀"
    elif [ "${cap:-0}" -ge 50 ];        then icon="󰁾"
    elif [ "${cap:-0}" -ge 30 ];        then icon="󰁼"
    elif [ "${cap:-0}" -ge 15 ];        then icon="󰁺"
    else icon="󰂃"; fi

    if [ "${cap:-0}" -le 15 ] && [ "$status" != "Charging" ]; then
        echo "${W}${icon} ${cap}%"
    else
        echo "${I}${icon}${V} ${cap}%"
    fi
}

get_network() {
    local ssid
    ssid=$(iwgetid -r 2>/dev/null)
    if [ -n "$ssid" ]; then
        echo "${I}󰤨${V} $ssid"
        return
    fi
    local eth
    eth=$(ip -o link show up 2>/dev/null | awk -F': ' '/^[0-9]+: e/{print $2; exit}')
    if [ -n "$eth" ]; then
        echo "${I}󰈀${V} eth"
        return
    fi
    echo "${I}󰤭${SEP} off"
}

get_spotify() {
    playerctl --player=spotify status 2>/dev/null | grep -q "Playing\|Paused" || return
    local status artist title icon
    status=$(playerctl --player=spotify status 2>/dev/null)
    artist=$(playerctl --player=spotify metadata artist 2>/dev/null)
    title=$(playerctl --player=spotify metadata title 2>/dev/null)
    [ "$status" = "Playing" ] && icon="󰎇" || icon="󰏤"
    echo "${I}${icon}${V} ${artist} - ${title}"
}

get_uptime() {
    local hours
    hours=$(awk '{printf "%d", $1/3600}' /proc/uptime)
    if [ "$hours" -ge 24 ]; then
        printf "%dd %dh" $((hours/24)) $((hours%24))
    else
        printf "%dh" "$hours"
    fi
}

while true; do
    CPU=$(get_cpu_usage)
    if [ "$CPU" -ge 80 ]; then
        CPU_STR="${W}󰻠 ${CPU}%"
    else
        CPU_STR="${I}󰻠${V} ${CPU}%"
    fi

    TEMP=$(get_cpu_temp)
    [ -z "$TEMP" ] && TEMP="?"
    if [ "$TEMP" != "?" ] && [ "$TEMP" -ge 80 ] 2>/dev/null; then
        TEMP_STR="${W}󰍛 ${TEMP}°"
    else
        TEMP_STR="${I}󰍛${V} ${TEMP}°"
    fi

    MEM_USED=$(free -m | awk '/^Mem/ {printf "%.1fG", $3/1024}')
    MEM_PCT=$(free | awk '/^Mem/ {printf "%d", $3/$2*100}')
    MEM_STR="${I}${V} ${MEM_USED} ${SEP}${MEM_PCT}%"

    DISK_FREE=$(df -h / | awk 'NR==2 {print $4}')
    DISK_PCT=$(df / | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
    DISK_STR="${I}${V} ${DISK_FREE} ${SEP}${DISK_PCT}%"

    NET=$(get_network)
    VOL=$(get_volume)
    BAT=$(get_battery)
    SPOTIFY=$(get_spotify)
    UP="${I}󰔚${V} $(get_uptime)"
    TIME="${I}󰥔${V} $(printf "%(%a %b %e  %H:%M)T\n")"

    STATUS="${CPU_STR}${S}${TEMP_STR}${S}${MEM_STR}${S}${DISK_STR}${S}${NET}${S}${VOL}"
    [ -n "$BAT" ] && STATUS="${STATUS}${S}${BAT}"
    [ -n "$SPOTIFY" ] && STATUS="${STATUS}${S}${SPOTIFY}"
    STATUS="${STATUS}${S}${UP}${S}${TIME}"

    xsetroot -name "$STATUS"
    sleep 5
done
