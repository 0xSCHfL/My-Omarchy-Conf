#!/bin/bash
# Show all shortcuts in dmenu for searching

cat <<'EOF' | dmenu -i -l 25 -p 'Shortcuts'
═══ DWM KEYBINDINGS ═══
Super + Space      → dmenu (app launcher)
Super + Return     → Terminal (st)
Super + q          → Browser (qutebrowser)
Super + b          → Toggle bar
Super + w          → Close window
Super + j          → Focus next window
Super + k          → Focus prev window
Super + i          → Increase master count
Super + d          → Decrease master count
Super + h          → Shrink master area
Super + l          → Grow master area
Super + t          → Toggle floating
Super + f          → Monocle layout
Super + m          → Monocle layout
Super + p          → Cycle layouts
Super + Tab        → View previous tag
Super + 1-9        → Switch to tag
Super + ,          → Focus prev monitor
Super + .          → Focus next monitor
Super + agrave     → Show all tags
Super + Shift + c  → Chromium
Super + Shift + b  → Brave
Super + Shift + r  → Restart DWM in-place
Super + Shift + q  → Quit DWM
Super + Shift + s  → System menu (kill/reboot/shutdown)
Super + Shift + t  → btop (floating)
Super + Shift + v  → Image clipboard history
Super + Shift + i  → Image picker (fzfub)
Super + Shift + w  → WhatsApp
Super + Shift + g  → ChatGPT
Super + Shift + x  → Twitter/X
Super + Shift + d  → Discord
Super + Shift + e  → Email
Super + Shift + o  → Obsidian
Super + Shift + ,  → Move window to prev monitor
Super + Shift + .  → Move window to next monitor
Super + Shift + 1-9 → Move window to tag
Super + Ctrl + q   → Kill client
Super + Ctrl + Delete → Quit DWM
Alt + Print        → Screen recording
Print              → Screenshot
Super + Ctrl + Print → OCR screenshot
Super + F1         → Show this help

═══ IMAGE PICKER (Super+Shift+i — fzfub m mode) ═══
Alt+w              → Set as wallpaper (pywal)
Enter              → Select file (copy path)
Ctrl+g             → Open in GIMP
Ctrl+d             → Delete file
Ctrl+e             → Strip EXIF
Ctrl+b             → Convert to B&W
Ctrl+w             → Add watermark
Ctrl+t             → Make transparent
Ctrl+f             → Flip horizontally
Ctrl+v             → Flip vertically
Ctrl+l             → Add black border
Ctrl+h             → Add white border
Ctrl+s             → Scale 50%
Alt+j              → Convert to JPG
Alt+p              → Convert to PNG
Ctrl+r             → Refresh list

═══ SYSTEM MENU (Super+Shift+s) ═══
kill               → Kill a process (fzf)
suspend            → Suspend to RAM
reboot             → Reboot system
shutdown           → Shutdown system
EOF
