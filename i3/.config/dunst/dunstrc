[global]
font = Iosevka 12
width = 400
height = (0, 120)
offset = (10, 10)
gap_size = 15
padding = 10
horizontal_padding = 15
frame_width = 2
frame_color = "#AD9770"
background = "#130f0f"
foreground = "#b2bdba"

[urgency_low]
background = "#130f0f"
foreground = "#b2bdba"

[urgency_normal]
background = "#130f0f"
