[global]
font = Iosevka 12
width = 400
height = (0, 120)
offset = (10, 10)
gap_size = 15
padding = 10
horizontal_padding = 15
frame_width = 2
frame_color = "#A19320"
background = "#0E0D05"
foreground = "#e2d59c"

[urgency_low]
background = "#0E0D05"
