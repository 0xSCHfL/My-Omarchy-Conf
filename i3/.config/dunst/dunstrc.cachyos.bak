[global]
font = Iosevka 12
width = 400
height = (0, 120)
offset = (10, 10)
gap_size = 15
padding = 10
horizontal_padding = 15
frame_width = 2
frame_color = "#778482"
background = "#090c09"
foreground = "#e4e6e1"

[urgency_low]
background = "#090c09"
foreground = "#e4e6e1"

[urgency_normal]
background = "#090c09"
foreground = "#e4e6e1"

[urgency_critical]
background = "#897652"
foreground = "#e4e6e1"
timeout = 30
