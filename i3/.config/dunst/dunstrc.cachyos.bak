[global]
font = Iosevka 12
monitor = 0
follow = keyboard
width = 400
height = (0, 120)
origin = top-right
offset = (10, 10)
gap_size = 15
padding = 10
horizontal_padding = 15
frame_width = 2
frame_color = "#A5A37A"
background = "#1d1f25"
foreground = "#d7d6c1"

[urgency_low]
background = "#1d1f25"
foreground = "#d7d6c1"

[urgency_normal]
background = "#1d1f25"
foreground = "#d7d6c1"

[urgency_critical]
background = "#817E63"
foreground = "#d7d6c1"
timeout = 30
