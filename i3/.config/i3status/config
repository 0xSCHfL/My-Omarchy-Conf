general {
    colors = true
    interval = 5
    color_good = "#00FF41"
    color_degraded = "#FFB300"
    color_bad = "#FF0000"
    separator = "|"
}

order += "ipv6"
order += "cpu_temperature 0"
order += "disk /"
order += "wireless wlan0"
order += "ethernet eno1"
order += "cpu_usage"
order += "load"
order += "tztime local"

ipv6 {
    format_up = "Useless Protocol: %ip"
    format_down = "Useless Protocol: N/A"
}

cpu_temperature 0 {
    format = "Tem: %degrees °C"
    path = "/sys/class/thermal/thermal_zone0/temp"
}

disk "/" {
    format = "Penger Folder: %free"
}

wireless wlan0 {
    format_up = "W: %essid"
    format_down = "W: down"
}

ethernet eno1 {
    format_up = "E: Leaked IP: %ip (%speed)"
    format_down = "E: N/A"
}

cpu_usage {
    format = "Fairy Dust: %usage"
}

load {
    format = "Hot Loads: %1min"
}

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}
