[global_config]
output_format=i3bar
markup=pango
interval=5
separator_block_width=0
separator=false

[screenrecord]
command=~/.config/i3blocks/scripts/screenrecord
interval=once
signal=9
markup=pango
separator=false

[window_title]
command=~/.config/i3blocks/scripts/window-title
interval=1
separator_block_width=0
separator=false

[voxtype]
command=~/.config/i3blocks/scripts/voxtype
interval=1
separator=false

[spotify]
command=~/.config/i3blocks/scripts/spotify.sh
interval=2
color=#1DB954
separator=false

[wireless]
command=~/.config/i3blocks/scripts/wifi
interval=10
separator=false

[bluetooth]
command=~/.config/i3blocks/scripts/bluetooth
interval=10
signal=11
separator=false

[gdrive]
command=~/.config/i3blocks/scripts/gdrive
interval=30
signal=12
separator=false

[ethernet]
command=ip=$(ip addr show eno1 2>/dev/null| awk '/inet /{print $2}'| cut -d/ -f1); [ -n "$ip" ] && printf "| 󰈀 %s\n\n#ea999c\n" "$ip"
interval=10
separator=false

[load]
command=echo "| 󰾆 $(awk '{print $1}' /proc/loadavg)"
interval=2
color=#e5c890
separator=false

[systemstats]
command=~/.config/i3blocks/scripts/systemstats
interval=2
separator=false

[disks]
command=~/.config/i3blocks/scripts/disks
interval=30
signal=3
color=#a6d189
separator=false

[audio]
command=~/.config/i3blocks/scripts/audio
interval=2
signal=10
separator=false

[timer]
command=~/.config/i3blocks/scripts/timer
interval=once
signal=3
color=#babbf1
separator=false

[battery]
command=~/.config/i3blocks/scripts/battery
interval=5
signal=3
separator=false

[time]
command=~/.config/i3blocks/scripts/timedate
interval=1
color=#8caaee
