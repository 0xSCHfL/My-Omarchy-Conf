[global_config]
output_format=i3bar
markup=pango
interval=5
separator_block_width=2

[spotify]
command=~/.config/i3blocks/scripts/spotify.sh
interval=2
color=#1DB954

[wireless]
command=essid=$(iwgetid -r 2>/dev/null); [ -n "$essid" ] && echo "W: $essid" || echo "W: down"
interval=10

[ethernet]
command=ip=$(ip addr show eno1 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1); [ -n "$ip" ] && echo "E: Leaked IP: $ip" || echo "E: N/A"
interval=10

[load]
command=echo "Load: $(awk '{print $1}' /proc/loadavg)"
interval=2

[systemstats]
command=~/.config/i3blocks/scripts/systemstats
interval=2

[disks]
command=~/.config/i3blocks/scripts/disks
interval=30
signal=3

[audio]
command=vol=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '/Volume/{printf "%d%%", $5}'); mute=$(pactl get-sink-mute @DEFAULT_SINK@); [ "$mute" = "Mute: yes" ] && echo "Vol: $vol [M]" || echo "Vol: $vol"
interval=1

[timer]
command=~/.config/i3blocks/scripts/timer
interval=once
signal=3

[battery]
command=BAT=/sys/class/power_supply/BAT0; [ -d "$BAT" ] && echo "🔋 $(cat $BAT/capacity)%" || echo "N/A"
interval=5
signal=3

[time]
command=~/.config/i3blocks/scripts/timedate
interval=1
