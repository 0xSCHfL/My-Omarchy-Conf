#!/bin/bash

THRESHOLD=15
NOTIFICATION_FLAG="/tmp/i3_battery_notified"
BATTERY_PATH="/sys/class/power_supply/BAT0"

while true; do
  if [ -d "$BATTERY_PATH" ]; then
    capacity=$(cat "$BATTERY_PATH/capacity" 2>/dev/null)
    status=$(cat "$BATTERY_PATH/status" 2>/dev/null)

    if [[ -n "$capacity" && "$status" == "Discharging" && "$capacity" -le "$THRESHOLD" ]]; then
      if [ ! -f "$NOTIFICATION_FLAG" ]; then
        notify-send -u critical "🔋 Low Battery" "Battery is at ${capacity}%" -t 30000
        touch "$NOTIFICATION_FLAG"
      fi
    elif [[ "$status" == "Charging" || "$capacity" -gt "$THRESHOLD" ]]; then
      rm -f "$NOTIFICATION_FLAG"
    fi
  fi
  sleep 30
done