#!/bin/bash

# Auto-detect BAT* power supply (BAT0, BAT1, ...).
# Falls back to N/A on desktops / VMs with no battery.
BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)

icons=("󰁺" "󰁻" "󰁼" "󰁽" "󰁾" "󰁿" "󰂀" "󰂁" "󰂂" "󰁹")
icon_charging="󰂄"

if [ -z "$BAT" ] || [ ! -d "$BAT" ]; then
    echo "| N/A"
    exit 0
fi

CAPACITY=$(cat $BAT/capacity)
STATUS=$(cat $BAT/status)

idx=$(( (CAPACITY - 1) / 10 ))
[[ $idx -lt 0 ]] && idx=0
[[ $idx -gt 9 ]] && idx=9
ICON="${icons[$idx]}"

if [[ "$STATUS" == "Charging" || "$STATUS" == "Full" ]]; then
    echo "| $icon_charging ${CAPACITY}%"
    echo ""
    echo "#a6d189"
elif [[ "$CAPACITY" -le 15 ]]; then
    echo "| $ICON ${CAPACITY}%"
    echo ""
    echo "#ea999c"
elif [[ "$CAPACITY" -le 30 ]]; then
    echo "| $ICON ${CAPACITY}%"
    echo ""
    echo "#e5c890"
else
    echo "| $ICON ${CAPACITY}%"
    echo ""
    echo "#99d1db"
fi

case $BLOCK_BUTTON in
    1) setsid -f "$HOME/.local/bin/i3-cpufreq" ;;
    2) setsid -f "$HOME/.local/bin/i3-cpufreq" monitor ;;
    3) setsid -f "$HOME/.local/bin/i3-cpufreq" stats ;;
esac
