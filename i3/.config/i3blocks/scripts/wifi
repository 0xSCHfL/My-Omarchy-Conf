#!/bin/bash

TERMINAL_BIN="alacritty"

# Hide when the default route is over a wired (non-wireless) interface.
# The previous awk regex matched any interface whose name started with "e"
# and then attributed the next "inet" line to it, which incorrectly hid
# the wifi block whenever wlan0 had an IP.
iface=$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "dev") {print $(i+1); exit}}')
if [ -n "$iface" ] && ! iw dev "$iface" info >/dev/null 2>&1; then
    exit 0
fi

ESSID=$(iwgetid -r 2>/dev/null)

if [ -n "$ESSID" ]; then
    echo "| 󰤨 $ESSID"
    echo ""
    echo "#ffffff"
else
    echo "| 󰤭 down"
    echo ""
    echo "#737994"
fi

case $BLOCK_BUTTON in
    1) setsid -f "$TERMINAL_BIN" --class i3-wifi -e bash -lc 'rfkill unblock wifi 2>/dev/null; impala' ;;
esac
