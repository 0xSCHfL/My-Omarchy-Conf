#!/bin/bash

TERMINAL_BIN="alacritty"

# Hide when any ethernet interface has an IP (ethernet takes priority)
eth_ip=$(ip addr | awk '/^[0-9]+: e/{iface=1} iface && /inet /{split($2,a,"/"); print a[1]; iface=0}' | head -1)
[ -n "$eth_ip" ] && exit 0

ESSID=$(iwgetid -r 2>/dev/null)

if [ -n "$ESSID" ]; then
    echo "| 󰤨 $ESSID"
    echo ""
    echo "#ffffff"
else
    echo "| 󰤭 down"
    echo ""
    echo "#737994"
fi

case $BLOCK_BUTTON in
    1) setsid -f "$TERMINAL_BIN" --class i3-wifi -e bash -lc 'rfkill unblock wifi 2>/dev/null; impala' ;;
esac
