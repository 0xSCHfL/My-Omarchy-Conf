/* i3 keybinding help — Omarchy-inspired searchable palette */
@import "~/.cache/wal/colors-rofi-dwm.rasi"

configuration {
    matching: "fuzzy";
    show-icons: false;
}

* {
    bg:          @wal-bg;
    fg:          @wal-fg;
    fg-dim:      @wal-fg-dim;
    accent:      @wal-accent;
    prompt:      @wal-prompt;
    border:      @wal-border;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location:         center;
    width:            860px;
    border:           2px;
    border-radius:    4px;
    border-color:     @border;
    background-color: @bg;
}

mainbox {
    padding: 18px;
    spacing: 12px;
}

inputbar {
    padding: 10px 12px;
    spacing: 8px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.05);
    children: [ prompt, entry ];
}

prompt {
    font:       "Iosevka Nerd Font Bold 14";
    text-color: @prompt;
}

entry {
    font:              "Iosevka Nerd Font 14";
    placeholder:       "Search keybindings...";
    placeholder-color: @fg-dim;
}

listview {
    lines:        16;
    columns:      1;
    fixed-height: false;
    spacing:      4px;
    border:       1px 0 0 0;
    border-color: @border;
    padding:      10px 0 0 0;
}

element {
    padding:      9px 12px;
    border:       1px;
    border-color: transparent;
    border-radius: 2px;
    background-color: transparent;
}

element selected normal {
    border-color:     @accent;
    background-color: rgba(255, 255, 255, 0.10);
}

element-text {
    font:           "Iosevka Nerd Font 13";
    text-color:     @fg;
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @accent;
}

scrollbar {
    width: 0;
}
