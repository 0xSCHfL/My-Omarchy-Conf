/* Media picker — wide, single-column Melange panel for long track titles */
@import "~/.cache/wal/colors-rofi-dwm.rasi"

* {
    bg:          @wal-bg;
    fg:          @wal-fg;
    fg-dim:      @wal-fg-dim;
    accent:      @wal-accent;
    prompt:      @wal-prompt;
    border:      @wal-border;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    width:            780px;
    border:           1px;
    border-radius:    16px;
    border-color:     @border;
    background-color: @bg;
}

mainbox {
    padding: 16px;
    spacing: 10px;
}

inputbar {
    padding:          12px 14px;
    spacing:          10px;
    border-radius:    12px;
    background-color: rgba(255, 255, 255, 0.04);
    children:         [ prompt, entry ];
}

prompt {
    font:       "Iosevka Nerd Font Bold 13";
    text-color: @prompt;
}

entry {
    font:              "Iosevka Nerd Font 13";
    placeholder:       "choose media...";
    placeholder-color: @fg-dim;
}

listview {
    lines:        7;
    columns:      1;
    fixed-height: true;
    spacing:      4px;
    border:       0;
}

element {
    padding:          10px 13px;
    border:            1px;
    border-radius:     10px;
    border-color:      transparent;
    background-color:  transparent;
}

element selected normal,
element selected active {
    border-color:     @prompt;
    background-color: rgba(255, 255, 255, 0.07);
}

element-text {
    font:           "Iosevka Nerd Font 12";
    text-color:     @fg;
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @accent;
}

scrollbar {
    width: 0;
}
