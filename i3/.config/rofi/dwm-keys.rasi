/* Keybinding menus — pywal card style */
@import "~/.cache/wal/colors-rofi-dwm.rasi"

* {
    bg:          @wal-bg;
    fg:          @wal-fg;
    fg-dim:      @wal-fg-dim;
    accent:      @wal-accent;
    prompt:      @wal-prompt;
    border:      @wal-border;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location:         center;
    width:            720px;
    border:           1px;
    border-radius:    18px;
    border-color:     @border;
    background-color: @bg;
}

mainbox {
    padding: 18px;
    spacing: 12px;
}

inputbar {
    padding:       13px 15px;
    spacing:       10px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04);
    children:      [ prompt, entry ];
}

prompt {
    font:       "Iosevka Nerd Font Bold 13";
    text-color: @prompt;
}

entry {
    font:              "Iosevka Nerd Font 12";
    placeholder:       "j/k move  h/Esc back  q quit";
    placeholder-color: @fg-dim;
}

listview {
    lines:        12;
    columns:      1;
    fixed-height: false;
    spacing:      7px;
    border:       0;
}

element {
    padding:       9px 14px;
    border:        1px;
    border-radius: 12px;
    border-color:  transparent;
    background-color: transparent;
}

element selected normal {
    border-color:     @prompt;
    background-color: rgba(255, 255, 255, 0.06);
}

element-text {
    font:           "Iosevka Nerd Font 12";
    text-color:     @fg;
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @accent;
}

scrollbar {
    width: 0;
}
