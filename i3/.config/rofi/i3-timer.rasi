/* Timer prompt — compact single-line popup */
@import "~/.cache/wal/colors-rofi-dwm.rasi"

* {
    bg:          @wal-bg;
    fg:          @wal-fg;
    fg-dim:      @wal-fg-dim;
    accent:      @wal-accent;
    prompt:      @wal-prompt;
    border:      @wal-border;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location:         center;
    width:            320px;
    border:           1px;
    border-radius:    16px;
    border-color:     @border;
    background-color: @bg;
}

mainbox {
    padding: 14px;
    spacing: 8px;
}

inputbar {
    padding:       10px 12px;
    spacing:       8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    children:      [ prompt, entry ];
}

prompt {
    font:       "Iosevka Nerd Font Bold 12";
    text-color: @prompt;
}

entry {
    font:              "Iosevka Nerd Font 12";
    placeholder:       "minutes";
    placeholder-color: @fg-dim;
}

listview {
    lines:        0;
    columns:      1;
    fixed-height: false;
    border:       0;
}

scrollbar {
    width: 0;
}
