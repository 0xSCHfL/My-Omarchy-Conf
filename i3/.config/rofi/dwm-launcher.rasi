/* App launcher — pywal colors */
@import "~/.cache/wal/colors-rofi-dwm.rasi"

* {
    background-color: transparent;
    text-color:       @wal-fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @wal-bg;
    location:         center;
    width:            560;
    border-radius:    8;
    border:           1px;
    border-color:     @wal-border;
}

inputbar {
    font:     "monospace 13";
    padding:  12px 16px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @wal-prompt;
    font:       "monospace Bold 13";
    margin:     0 8px 0 0;
}

entry {
    font:             "monospace 13";
    placeholder:      "search apps...";
    placeholder-color: @wal-fg-dim;
}

separator {
    height:           1px;
    background-color: @wal-border;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    padding:      6px 0;
    border:       0;
}

element {
    padding:      7px 16px;
    font:         "monospace 12";
    border:       0 0 0 3px;
    border-color: transparent;
}

element selected normal {
    text-color:   @wal-accent;
    border-color: @wal-prompt;
}

element normal normal {
    text-color: @wal-fg;
}

element-icon {
    size:   24px;
    margin: 0 8px 0 0;
}

element-text {
    vertical-align: 0.5;
}

scrollbar {
    width:        3px;
    handle-color: @wal-border;
}
