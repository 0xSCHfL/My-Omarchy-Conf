# Wallpaper picker rofi list (wallpaper-pick.sh)
bindsym Mod4+Ctrl+space exec --no-startup-id $HOME/.config/i3/scripts/wallpaper/wallpaper-pick.sh
# Screenshot region/window to clipboard (i3-screenshot)
