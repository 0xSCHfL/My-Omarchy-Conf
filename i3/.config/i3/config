# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!
#
# This config file uses keycodes (bindsym) and was written for the QWERTY
# layout.
#
# To get a config file with the same key positions, but for your current
# layout, use the i3-config-wizard
#

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Iosevka 10

# Dark mode for all applications
exec --no-startup-id export GTK_THEME=Adwaita-dark
exec --no-startup-id export GTK_APPLICATIONS_PREFER_DARK_THEME=1
exec --no-startup-id export QT_STYLE_OVERRIDE=adwaita-dark
exec --no-startup-id export QT_QPA_PLATFORMTHEME=qt5ct

set_from_resource $wal_bg background #262626
set_from_resource $wal_fg foreground #c0b18b
set_from_resource $wal_dim color8 #656565
set_from_resource $wal_accent color4 #d4d232
set_from_resource $wal_alert color1 #d75f5f
set_from_resource $wal_panel background #262626

default_border none

# Hide the blue tiling drag indicator
client.focused          $wal_bg $wal_bg $wal_fg $wal_bg $wal_bg
client.unfocused        $wal_bg $wal_bg $wal_dim $wal_bg $wal_bg
client.focused_inactive $wal_bg $wal_bg $wal_dim $wal_bg $wal_bg
default_floating_border none
for_window [class=".*"] border none

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id systemctl --user start pipewire pipewire-pulse wireplumber
exec_always --no-startup-id xinput set-prop "SYNA308F:00 06CB:CD77 Touchpad" "libinput Tapping Enabled" 1
exec_always --no-startup-id xinput set-prop "SYNA308F:00 06CB:CD77 Touchpad" "libinput Natural Scrolling Enabled" 1
exec_always --no-startup-id xset s off -dpms

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- $HOME/.local/bin/i3-lock
exec_always --no-startup-id $HOME/.local/bin/i3-idle

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
#exec_always --no-startup-id $HOME/.config/polybar/launch.sh
exec --no-startup-id picom --daemon
exec --no-startup-id dunst
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id copyq
exec --no-startup-id $HOME/.config/i3/scripts/wallpaper/wallpaper-set.sh
exec_always --no-startup-id bash -c 'pkill -f "\.local/bin/i3-cliphist$" 2>/dev/null; sleep 0.1; exec $HOME/.local/bin/i3-cliphist'
exec_always --no-startup-id bash -c 'pkill -f "\.local/bin/i3-imgclipwatch$" 2>/dev/null; sleep 0.1; exec $HOME/.local/bin/i3-imgclipwatch'
exec_always --no-startup-id bash -c 'pkill -f "\.local/bin/batmon$" 2>/dev/null; sleep 0.1; exec $HOME/.local/bin/batmon'
# DISABLED: i3-autolayout was closing terminals in workspace 4
# exec_always --no-startup-id bash -c 'pkill -f "i3-autolayout" 2>/dev/null; sleep 0.1; exec i3-autolayout autolayout'

# Volume keys with a real i3 floating popup
bindsym XF86AudioRaiseVolume exec --no-startup-id $HOME/.config/i3/scripts/media/volume-osd.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id $HOME/.config/i3/scripts/media/volume-osd.sh down
bindsym XF86AudioMute exec --no-startup-id $HOME/.config/i3/scripts/media/volume-osd.sh mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness controls
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# WiFi and Audio controls
bindsym Mod4+Ctrl+w exec --no-startup-id $HOME/.config/i3/scripts/media/i3-launch-wifi.sh
bindsym Mod4+Ctrl+a exec --no-startup-id $HOME/.config/i3/scripts/media/i3-launch-audio.sh
bindsym Mod4+Shift+g exec --no-startup-id alacritty --class i3-gdrive -e i3-gdrive

# Dictation (voxtype) — toggle: Super+Ctrl+X to record, press again to stop & auto-type
bindsym Mod4+Ctrl+x exec --no-startup-id $HOME/.config/i3/scripts/utils/voxtype-toggle-paste.sh

# Notification controls (dunst)
bindsym Mod4+comma exec dunstctl close
bindsym Mod4+Shift+comma exec dunstctl close-all
bindsym Mod4+Ctrl+comma exec dunstctl set-paused toggle
bindsym Mod4+Mod1+comma exec dunstctl invoke

# use these keys for focus, movement, and resize directions when reaching for
# the arrows is not convenient
set $up k
set $down j
set $left h
set $right l

# use Mouse+Mod4 to drag floating windows to their wanted position
floating_modifier Mod4
for_window [class="i3-screensaver"] fullscreen enable, border none
for_window [class="Nsxiv"] floating enable, resize set 1200 700, move position center
for_window [class="fzfmenu"] floating enable, move position center
for_window [class="fzf"] floating enable, move position center
for_window [class="Walker"] floating enable, resize set 644 300, move position center
for_window [class="walker"] floating enable, resize set 644 300, move position center
for_window [title="Walker"] floating enable, resize set 644 300, move position center
for_window [class="copyq"] floating enable, resize set 500 400, move position 3330 640
for_window [title="volume-osd"] floating enable, resize set 360 100, move position center
for_window [class="i3statspopup"] floating enable, resize set 900 650, move position center
for_window [class="i3diskpopup"] floating enable, resize set 760 360, move position center
for_window [class="i3timerpopup"] floating enable, resize set 520 220, move position center
for_window [class="i3cpufreq"] floating enable, resize set 900 600, move position center
for_window [class="i3-wifi"] floating enable, resize set 800 600, move position center
for_window [class="i3-audio"] floating enable, resize set 800 600, move position center
for_window [class="i3-bluetooth"] floating enable, resize set 800 600, move position center
for_window [class="i3-gdrive"] floating enable, resize set 1100 680, move position center
for_window [class="i3-gdrive-setup"] floating enable, resize set 800 500, move position center
for_window [class="notes-nvim"] floating enable, resize set 1200 800, move position center

# Media viewers — open as floating
for_window [class="^imv$"] floating enable, resize set 1200 750, move position center
for_window [class="^imv-folder$"] floating enable, resize set 1200 750, move position center
for_window [class="^feh$"] floating enable, resize set 1200 750, move position center
for_window [class="^mpv$"] floating enable, resize set 1200 700, move position center
for_window [class="^Evince$"] floating enable, resize set 1100 800, move position center
for_window [class="^Zathura$"] floating enable, resize set 1100 800, move position center

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# start a terminal
bindsym Mod4+Return exec kitty
bindsym Mod4+Shift+b exec --no-startup-id i3-brave
bindsym Mod4+Shift+s exec bash -c 'rm -f ~/.var/app/com.spotify.Client/cache/spotify/Singleton* && flatpak run com.spotify.Client'
bindsym Mod4+Shift+Mod1+b exec --no-startup-id i3-brave --incognito
bindsym Mod4+Shift+c exec bash -c 'rm -f ~/.config/chromium/Singleton* && chromium --ozone-platform=x11'
# Super+Shift+v merged into Super+v (combined text+image picker)
bindsym Mod4+Shift+t exec --no-startup-id kitty -e btop
bindsym Mod4+Shift+m exec --no-startup-id ~/.config/i3blocks/scripts/timer menu

# kill focused window
bindsym Mod4+w kill

# start dmenu (a program launcher)
bindsym Mod4+space exec --no-startup-id rofi -show drun -theme ~/.config/rofi/i3-launcher.rasi
# A more modern dmenu replacement is rofi:
# bindsym Mod4+d exec "rofi -modi drun,run -show drun"
# There also is i3-dmenu-desktop which only displays applications shipping a
# .desktop file. It is a wrapper around dmenu, so you need that installed.
# bindsym Mod4+d exec --no-startup-id i3-dmenu-desktop

# change focus
bindsym Mod4+$left focus left
bindsym Mod4+$down focus down
bindsym Mod4+$up focus up
bindsym Mod4+$right focus right

# alternatively, you can use the cursor keys:
bindsym Mod4+Left focus left
bindsym Mod4+Down focus down
bindsym Mod4+Up focus up
bindsym Mod4+Right focus right

# move focused window
bindsym Mod4+Shift+$left move left
bindsym Mod4+Shift+$down move down
bindsym Mod4+Shift+$up move up
bindsym Mod4+Shift+$right move right

# alternatively, you can use the cursor keys:
bindsym Mod4+Shift+Left move left
bindsym Mod4+Shift+Down move down
bindsym Mod4+Shift+Up move up
bindsym Mod4+Shift+Right move right

# split in horizontal orientation
bindsym Mod4+Ctrl+h split h
# split in vertical orientation
bindsym Mod4+Ctrl+l split v


# true fullscreen: hides bar (like Hyprland fullscreen 0)
bindsym Mod4+f exec --no-startup-id ~/.config/i3/scripts/utils/fullscreen.sh

# file manager
bindsym Mod4+Shift+f exec --no-startup-id nautilus --new-window
# maximize: fills screen, bar stays, app UI preserved (not fullscreen)
bindsym Mod4+Mod1+f exec --no-startup-id ~/.config/i3/scripts/utils/maximize.sh

# change container layout (stacked, tabbed, toggle split)
bindsym Mod4+o layout stacking
bindsym Mod4+e layout toggle split

# toggle tiling / floating
bindsym Mod4+t exec --no-startup-id $HOME/.config/i3/scripts/utils/float-toggle.sh
bindsym Mod4+Shift+space floating toggle

# change focus between tiling / floating windows
# bindsym Mod4+space focus mode_toggle

# focus the parent container
bindsym Mod4+a focus parent

# focus the child container
#bindsym Mod4+d focus child

# move the currently focused window to the scratchpad
bindsym Mod4+s move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym Mod4+Mod1+s scratchpad show

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym Mod4+1 workspace number $ws1
bindsym Mod4+2 workspace number $ws2
bindsym Mod4+3 workspace number $ws3
bindsym Mod4+4 workspace number $ws4
bindsym Mod4+5 workspace number $ws5
bindsym Mod4+6 workspace number $ws6
bindsym Mod4+7 workspace number $ws7
bindsym Mod4+8 workspace number $ws8
bindsym Mod4+9 workspace number $ws9
bindsym Mod4+0 workspace number $ws10

# move focused container to workspace
bindsym Mod4+Shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym Mod4+Shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym Mod4+Shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym Mod4+Shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym Mod4+Shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym Mod4+Shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym Mod4+Shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym Mod4+Shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym Mod4+Shift+9 move container to workspace number $ws9; workspace number $ws9
bindsym Mod4+Shift+0 move container to workspace number $ws10; workspace number $ws10

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym Mod4+Shift+r restart
bindsym Mod4+Ctrl+r exec i3-msg reload
# exit i3 (logs you out of your X session)
bindsym Mod4+x exec --no-startup-id i3-lock
bindsym Mod4+Shift+q exec "echo -e 'No\nYes'| rofi -dmenu -no-sort -i -theme ~/.config/rofi/dwm-keys.rasi -kb-row-up 'k,Up' -kb-row-down 'j,Down' -kb-cancel 'Escape,h,q' -p 'Exit i3?'| grep -q 'Yes' && i3-msg exit"
bindsym Mod4+Ctrl+space exec --no-startup-id $HOME/.config/i3/scripts/wallpaper/wallpaper-pick.sh
bindsym Mod4+Ctrl+v exec --no-startup-id copyq show
bindsym Print exec --no-startup-id i3-screenshot
bindsym Mod4+Print exec --no-startup-id i3-screenrecord
bindsym Mod4+Ctrl+Print exec --no-startup-id i3-ocr
bindsym Mod4+Ctrl+k exec --no-startup-id i3-keys
bindsym Mod4+Ctrl+e exec --no-startup-id i3-emojipick
bindsym Mod4+q exec --no-startup-id qutebrowser
bindsym Mod4+Shift+o exec --no-startup-id obsidian
bindsym Mod4+Shift+i exec --no-startup-id i3-imgpicker
bindsym Mod4+Mod1+t exec --no-startup-id Telegram -theme dark
bindsym Mod4+Shift+w exec --no-startup-id i3-webapp "https://web.whatsapp.com/"
bindsym Mod4+Shift+a exec --no-startup-id i3-webapp "https://chatgpt.com/"
bindsym Mod4+Shift+x exec --no-startup-id i3-webapp "https://x.com/"
bindsym Mod4+Shift+d exec --no-startup-id discord
bindsym Mod4+Shift+e exec --no-startup-id $HOME/.config/i3/scripts/launchers/i3-email-picker.sh
bindsym Mod4+n exec --no-startup-id notes
bindsym Mod4+Ctrl+n exec --no-startup-id bash $HOME/.config/i3/scripts/notifications/notifications.sh
bindsym Mod4+Shift+n exec --no-startup-id kitty -e nvim
# Clipboard history via rofi
bindsym Mod4+v exec --no-startup-id i3-cliphist-pick
bindsym Mod4+Shift+v exec --no-startup-id i3-imgcliphist
bindsym Mod4+Escape exec --no-startup-id i3-sys
bindsym Mod4+Delete exec --no-startup-id i3-kill

bindsym Mod1+Tab exec --no-startup-id $HOME/.config/i3/scripts/utils/focus-next.sh
bindsym Mod1+Shift+Tab exec --no-startup-id $HOME/.config/i3/scripts/utils/focus-next.sh prev

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym $left       resize shrink width 10 px or 10 ppt
        bindsym $down       resize grow height 10 px or 10 ppt
        bindsym $up         resize shrink height 10 px or 10 ppt
        bindsym $right      resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left        resize shrink width 10 px or 10 ppt
        bindsym Down        resize grow height 10 px or 10 ppt
        bindsym Up          resize shrink height 10 px or 10 ppt
        bindsym Right       resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or Mod4+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym Mod4+r mode "default"
}

bindsym Mod4+r mode "resize"

bar {
    status_command i3blocks -c ~/.config/i3blocks/config
    position bottom
    font pango:Iosevka 12
    separator_symbol "▏"
    padding 2px
    tray_padding 2px
    colors {
        background $wal_bg
        statusline $wal_fg
        separator  $wal_dim
        focused_workspace  $wal_accent $wal_accent $wal_bg
        active_workspace   $wal_bg $wal_bg $wal_fg
        inactive_workspace $wal_bg $wal_bg $wal_dim
        urgent_workspace   $wal_alert $wal_alert $wal_bg
    }
}

# Gaps
gaps inner 10
gaps outer 10
smart_gaps off
smart_borders on

set $mode_gaps Gaps: (o) outer, (i) inner
set $mode_gaps_outer Outer Gaps: +|-|0 (local), Shift + +|-|0 (global)
set $mode_gaps_inner Inner Gaps: +|-|0 (local), Shift + +|-|0 (global)
bindsym Mod4+Ctrl+g mode "$mode_gaps"

mode "$mode_gaps" {
        bindsym o      mode "$mode_gaps_outer"
        bindsym i      mode "$mode_gaps_inner"
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
mode "$mode_gaps_inner" {
        bindsym plus        gaps inner current plus 5
        bindsym minus       gaps inner current minus 5
        bindsym 0           gaps inner current set 0
        bindsym Shift+plus  gaps inner all plus 5
        bindsym Shift+minus gaps inner all minus 5
        bindsym Shift+0     gaps inner all set 0
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
mode "$mode_gaps_outer" {
        bindsym plus        gaps outer current plus 5
        bindsym minus       gaps outer current minus 5
        bindsym 0           gaps outer current set 0
        bindsym Shift+plus  gaps outer all plus 5
        bindsym Shift+minus gaps outer all minus 5
        bindsym Shift+0     gaps outer all set 0
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
