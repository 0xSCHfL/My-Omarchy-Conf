bindsym Mod4+Ctrl+v exec --no-startup-id alacritty --class i3-cliphist-fzf -e i3-cliphist-fzf
# System menu: lock/suspend/reboot (i3-sys)
bindsym Mod4+Escape exec --no-startup-id i3-sys
# Pick & kill a process via rofi (i3-kill)
