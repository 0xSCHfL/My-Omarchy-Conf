#!/bin/bash
# Text clipboard history picker (rofi, vim-style nav)
while true; do
    sel=$(cliphist list | rofi -dmenu -no-sort -i \
        -theme ~/.config/rofi/dwm-keys.rasi \
        -kb-accept-entry 'Return,KP_Enter' \
        -kb-remove-to-eol '' \
        -kb-row-up 'ctrl+k,Up' \
        -kb-row-down 'ctrl+j,Down' \
        -kb-cancel 'Escape,h,q' \
        -kb-remove-char-forward '' \
        -kb-custom-1 'ctrl+d' \
        -p 'Clipboard:')

    case $? in
        0)  cliphist decode <<< "$sel" | setsid -f xclip -selection clipboard -i -quiet >/dev/null 2>&1; break ;;
        10) cliphist delete <<< "$sel" ;;  # delete and stay open
        *)  break ;;                        # Escape/cancel → close
    esac
done
