#!/bin/bash
# Clipboard history daemon — pipes clipboard changes into cliphist

LAST=""
while true; do
    clip=$(xclip -o -selection clipboard 2>/dev/null)
    if [ -n "$clip" ] && [ "$clip" != "$LAST" ]; then
        printf '%s' "$clip" | cliphist store
        LAST="$clip"
    fi
    sleep 1
done
