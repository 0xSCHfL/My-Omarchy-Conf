#!/bin/bash
# Clipboard history daemon — pipes clipboard changes into cliphist

LAST=""
LOCK_PATH="${CLIPHIST_LOCK_PATH:-$HOME/.cache/cliphist/.lock}"

store_clipboard() {
    local value="$1"
    mkdir -p "$(dirname "$LOCK_PATH")"
    {
        flock -x 9
        printf '%s' "$value" | cliphist store
    } 9>"$LOCK_PATH"
}

read_clipboard() {
    local target clip
    for target in UTF8_STRING text/plain STRING; do
        if clip=$(timeout 2 xclip -o -selection clipboard -target "$target" 2>/dev/null); then
            printf '%s' "$clip"
            return 0
        fi
    done
    return 1
}

clipboard_has_image() {
    xclip -selection clipboard -t TARGETS -o 2>/dev/null \
        | grep -Eq '^image/(png|jpeg|webp|bmp|tiff)$'
}

while true; do
    if clipboard_has_image; then
        # Image history is recorded by i3-imgclipwatch with a valid file path.
        # Do not feed binary image data into cliphist as text.
        sleep 1
        continue
    fi
    clip=$(read_clipboard || true)
    if [ -n "$clip" ] && [ "$clip" != "$LAST" ]; then
        store_clipboard "$clip"
        LAST="$clip"
    fi
    sleep 1
done
