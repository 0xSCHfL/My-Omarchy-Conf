#!/bin/bash
# Close all notifications before capture so they don't appear in the screenshot
dunstctl close-all

TMPFILE=$(mktemp "/tmp/screenshot-XXXXXX.png")
trap "rm -f '$TMPFILE'" EXIT

if maim -s "$TMPFILE" 2>/dev/null; then
  if [ -f "$TMPFILE" ] && [ -s "$TMPFILE" ]; then
    xclip -selection clipboard -t image/png -loops 0 < "$TMPFILE" &
    dunstify -u low -t 2000 "Screenshot" "Copied to clipboard"
  fi
else
  dunstify -u low -t 2000 "Screenshot" "Cancelled"
fi
