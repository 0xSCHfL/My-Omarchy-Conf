#!/usr/bin/env bash
# Kill duplicate singleton processes and restart any that are not running
# Run after Super+Shift+R to clean up duplicates and revive crashed daemons

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Exact binary name matches (pgrep -x)
SINGLETONS=(
    picom
    dunst
    i3blocks
    voxtype
)

# Partial matches for script-based daemons (pgrep -f)
SCRIPT_SINGLETONS=(
    "i3-cliphist"
    "i3-imgclipwatch"
    "\.local/bin/batmon"
    "xidlehook"
)

# Daemons to ensure are running: "pgrep_f_pattern|start_command"
ENSURE_RUNNING=(
    "i3-cliphist|setsid -f bash $HOME/.local/bin/i3-cliphist"
    "i3-imgclipwatch|setsid -f $HOME/.local/bin/i3-imgclipwatch"
    "\.local/bin/batmon|setsid -f $HOME/.local/bin/batmon"
    "dunst|setsid -f dunst"
    "picom|setsid -f picom --daemon"
    "i3blocks|setsid -f i3blocks"
    "voxtype|setsid -f voxtype daemon"
    "xidlehook|setsid -f xidlehook --timer 150 'DISPLAY=:0 i3-launch-screensaver' 'pkill -f i3-screensaver' --timer 150 'pkill -f i3-screensaver; DISPLAY=:0 i3-lock' ''"
)

killed_any=false
started_any=false

dedup() {
    local name="$1"
    local flag="$2"

    mapfile -t raw_pids < <(pgrep "$flag" "$name" 2>/dev/null)
    [[ ${#raw_pids[@]} -le 1 ]] && return

    mapfile -t sorted < <(
        ps -p "$(IFS=,; echo "${raw_pids[*]}")" -o pid= --sort=start_time 2>/dev/null
    )
    [[ ${#sorted[@]} -le 1 ]] && return

    local keep="${sorted[-1]}"
    local killed=0

    for pid in "${sorted[@]}"; do
        [[ "$pid" == "$keep" ]] && continue
        if kill "$pid" 2>/dev/null; then
            ((killed++))
            killed_any=true
        fi
    done

    echo -e "  ${YELLOW}${name}${RESET}: ${#sorted[@]} instances → ${RED}killed $killed stale${RESET} ${DIM}(kept PID $keep)${RESET}"
}

ensure_running() {
    local pattern="$1"
    local cmd="$2"
    local label="${pattern//\\/}"

    if ! pgrep -f "$pattern" >/dev/null 2>&1; then
        eval "$cmd" >/dev/null 2>&1
        echo -e "  ${CYAN}${label}${RESET}: not running ${RED}→${RESET} ${GREEN}started${RESET}"
        started_any=true
    fi
}

echo ""
echo -e "${BOLD}󰍉  Scanning for duplicate processes...${RESET}"
echo ""

for proc in "${SINGLETONS[@]}";        do dedup "$proc" -x; done
for proc in "${SCRIPT_SINGLETONS[@]}"; do dedup "$proc" -f; done

if [[ "$killed_any" == false ]]; then
    echo -e "  ${GREEN}✓${RESET} ${DIM}All clean — no duplicates found.${RESET}"
fi

echo ""
echo -e "${BOLD}󰐥  Checking required daemons...${RESET}"
echo ""

for entry in "${ENSURE_RUNNING[@]}"; do
    pattern="${entry%%|*}"
    cmd="${entry##*|}"
    ensure_running "$pattern" "$cmd"
done

if [[ "$started_any" == false ]]; then
    echo -e "  ${GREEN}✓${RESET} ${DIM}All daemons running.${RESET}"
fi

echo ""
echo -e "${GREEN}${BOLD}Done.${RESET}"
echo ""
