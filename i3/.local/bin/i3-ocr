#!/bin/bash
TMPFILE=$(mktemp /tmp/ocr-XXXXXX.png)
trap "rm -f '$TMPFILE'" EXIT

# Use maim for interactive selection
if ! maim -s "$TMPFILE" 2>/dev/null; then
  notify-send "OCR" "Cancelled"
  exit 1
fi

if [ ! -s "$TMPFILE" ]; then
  notify-send "OCR" "No selection made"
  exit 1
fi

# Run tesseract OCR
TEXT=$(tesseract "$TMPFILE" stdout --oem 1 --psm 6 -l eng 2>/dev/null)

if [ -z "$TEXT" ]; then
  notify-send "OCR" "No text found"
  exit 1
fi

# Copy to clipboard
printf "%s" "$TEXT" | xclip -selection clipboard
notify-send "✓ OCR" "Text copied to clipboard"
