#!/usr/bin/env bash

theme="$HOME/.config/rofi/i3-launcher.rasi"

choose() {
  rofi -dmenu -no-sort -i -theme "$theme" -p "$1"
}

case "$(printf "󰌾  Lock\n󰍃  Logout\n󰒲  Suspend\n󰜉  Reboot\n󰐥  Shutdown" | choose "System:")" in
    *Lock)     i3-lock ;;
    *Logout)   i3-msg exit ;;
    *Suspend)  systemctl suspend ;;
    *Reboot)   systemctl reboot ;;
    *Shutdown) shutdown now ;;
    *) exit 1 ;;
esac
