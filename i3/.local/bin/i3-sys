#!/usr/bin/env bash

theme="$HOME/.config/rofi/i3-launcher.rasi"

choose() {
  rofi -dmenu -no-sort -i -theme "$theme" -p "$1"
}

case "$(printf "kill\nsuspend\nreboot\nshutdown" | choose "System:")" in
    kill) ps -u "$USER" -o pid,comm,%cpu,%mem | choose "Kill:" | awk '{print $1}' | xargs -r kill ;;
    suspend) systemctl suspend ;;
    reboot) systemctl reboot ;;
    shutdown) shutdown now ;;
    *) exit 1 ;;
esac
