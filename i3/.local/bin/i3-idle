#!/usr/bin/env bash

set -euo pipefail

SCREENSAVER_TIMEOUT="${SCREENSAVER_TIMEOUT:-150}"
LOCK_TIMEOUT="${LOCK_TIMEOUT:-150}"

pkill -x xidlehook 2>/dev/null || true

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

exec xidlehook --not-when-fullscreen \
    --timer "$SCREENSAVER_TIMEOUT" \
        "$HOME/.local/bin/i3-launch-screensaver" \
        "$HOME/.local/bin/i3-stop-screensaver" \
    --timer "$LOCK_TIMEOUT" \
        "$HOME/.local/bin/i3-stop-screensaver; $HOME/.local/bin/i3-lock" \
        ""
