#!/usr/bin/env bash

set -euo pipefail

SCREENSAVER_TIMEOUT="${SCREENSAVER_TIMEOUT:-600}"
LOCK_TIMEOUT="${LOCK_TIMEOUT:-120}"
SLEEP_TIMEOUT="${SLEEP_TIMEOUT:-120}"

pkill -x xidlehook 2>/dev/null || true

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

exec xidlehook \
    --timer "$SCREENSAVER_TIMEOUT" \
        "$HOME/.local/bin/i3-idle-screensaver" \
        "$HOME/.local/bin/i3-stop-screensaver" \
    --timer "$LOCK_TIMEOUT" \
        "$HOME/.local/bin/i3-idle-lock" \
        "" \
    --timer "$SLEEP_TIMEOUT" \
        "$HOME/.local/bin/i3-idle-sleep" \
        ""
