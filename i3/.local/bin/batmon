#!/bin/bash

THRESHOLD=20
SUSPEND_THRESHOLD=5
FLAG_LOW="/tmp/batmon_low"
FLAG_FULL="/tmp/batmon_full"
FLAG_SUSPENDED="/tmp/batmon_suspended"

while true; do
    for bat in /sys/class/power_supply/BAT*; do
        [ -d "$bat" ] || continue
        level=$(cat "$bat/capacity" 2>/dev/null)
        status=$(cat "$bat/status" 2>/dev/null)

        if [[ "$status" == "Discharging" && "$level" -le "$THRESHOLD" ]]; then
            if [ ! -f "$FLAG_LOW" ]; then
                notify-send -u critical -t 30000 "🔋 Low Battery" "Battery at ${level}% — Plug in the charger!"
                touch "$FLAG_LOW"
            fi
            rm -f "$FLAG_FULL"
        elif [[ "$status" == "Charging" || "$level" -gt "$THRESHOLD" ]]; then
            rm -f "$FLAG_LOW"
        fi

        if [[ "$status" == "Full" || ( "$status" == "Charging" && "$level" -ge 100 ) ]]; then
            if [ ! -f "$FLAG_FULL" ]; then
                notify-send -u normal -t 10000 "🔋 Battery Full" "Battery at 100% — You can unplug the charger."
                touch "$FLAG_FULL"
            fi
        else
            rm -f "$FLAG_FULL"
        fi

        # Critical suspend: when discharging and at/below the
        # suspend threshold, fire systemctl suspend exactly once.
        # xss-lock will lock the screen first; on resume the charger
        # must be present or you'll boot straight into a fresh
        # shutdown. Re-arm on charge so a future discharge can trigger
        # again.
        if [[ "$status" == "Discharging" && "$level" -le "$SUSPEND_THRESHOLD" ]]; then
            if [ ! -f "$FLAG_SUSPENDED" ]; then
                notify-send -u critical -t 15000 "🔌 Suspending" "Battery at ${level}% — going to sleep now."
                touch "$FLAG_SUSPENDED"
                sleep 2
                systemctl suspend
            fi
        elif [[ "$status" == "Charging" || "$status" == "Full" ]]; then
            rm -f "$FLAG_SUSPENDED"
        fi
    done
    sleep 30
done
