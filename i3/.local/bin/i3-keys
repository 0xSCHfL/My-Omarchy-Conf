#!/usr/bin/env bash
# Keybindings help, auto-generated from ~/.config/i3/config (description = comment line above each bindsym)

CONFIG="$HOME/.config/i3/config"
ROFI_THEME="$HOME/.config/rofi/i3-help.rasi"
ROFI_NAV=(-kb-row-up "Up" -kb-row-down "Down" -kb-cancel "Escape")

rofi_menu() {
    rofi -dmenu -no-sort -i -no-custom -matching fuzzy \
        -theme "$ROFI_THEME" "${ROFI_NAV[@]}" \
        -p "$1" -mesg 'Search all keybindings  •  ↑/↓ move  •  Esc close'
}

categorize() {
    awk '
        function subcat(key, cmd) {
            if (key ~ /^XF86Audio/) return "Volume & Player"
            if (key ~ /^XF86MonBrightness/) return "Brightness"
            if (cmd ~ /playerctl|pactl|volume-osd/) return "Volume & Player"
            if (cmd ~ /brightnessctl/) return "Brightness"
            if (cmd ~ /i3-launch-wifi|i3-launch-vpn|vortix|impala/) return "Network"
            if (cmd ~ /dunstctl|notification-sound/) return "Notifications"
            if (cmd ~ /cliphist/) return "Clipboard"
            if (cmd ~ /screenshot|screenrecord|i3-ocr/) return "Screenshots"
            if (cmd ~ /wallpaper|i3-imgpicker/) return "Wallpaper"
            if (cmd ~ /i3-lock|i3-sys|i3-kill|^restart$|^reload$|i3-msg|Exit i3/) return "Session"
            if (cmd ~ /^kill$|floating|fullscreen|maximize|float-toggle|^layout |split|^focus|^move|^a$/) return "Window control"
            if (cmd ~ /^resize|^mark/) return "Window control"
            if (cmd ~ /workspace/) return "Workspaces"
            if (cmd ~ /scratchpad/) return "Scratchpad"
            if (cmd ~ /^mode /) return "Modes"
            return "Apps & Launchers"
        }
        function maincat(s) {
            if (s == "Window control" || s == "Workspaces" || s == "Scratchpad" || s == "Modes") return "Desktop"
            if (s == "Session" || s == "Notifications" || s == "Screenshots") return "System"
            if (s == "Network") return "System"
            if (s == "Volume & Player" || s == "Brightness") return "Media"
            return "Apps & Tools"
        }

        # Track the most recent comment line. Reset on blank lines so a comment
        # one line above a bindsym always wins.
        /^[[:space:]]*#/ {
            line = $0
            sub(/^[[:space:]]*#[[:space:]]*/, "", line)
            last_comment = line
            next
        }
        /^[[:space:]]*$/ { last_comment = ""; next }

        /^bindsym / {
            binding = $2
            cmd = ""
            for (i = 3; i <= NF; i++) cmd = cmd " " $i
            sub(/^ /, "", cmd)

            scat = subcat(binding, cmd)
            mcat = maincat(scat)

            desc = last_comment
            if (desc == "") {
                desc = cmd
                sub(/^exec[[:space:]]+(--no-startup-id[[:space:]]+)?/, "", desc)
                gsub(/\$HOME\/\.config\/i3\/scripts\/[^ ]+\//, "", desc)
                gsub(/\$HOME\/\.local\/bin\//, "", desc)
                gsub(/\$HOME\//, "~/", desc)
                if (length(desc) > 60) desc = substr(desc, 1, 57) "..."
            }

            disp_key = binding
            gsub(/Mod4/, "Super", disp_key)
            gsub(/Mod1/, "Alt", disp_key)

            printf "%s\t%s\t%-28s →  %s\n", mcat, scat, disp_key, desc
            # Consume the comment so it does not apply to the next bindsym
            last_comment = ""
            next
        }

        # Any other non-comment line breaks the comment chain
        { last_comment = "" }
    ' "$CONFIG"
}

bindings=$(categorize)

# Present every binding in one searchable list, like Omarchy's keybindings
# palette. Searching now matches the key, category, subcategory, or action.
display_bindings=$(printf '%s\n' "$bindings" | awk -F'\t' '{
    printf "%-28s  %-24s  %s\n", $3, $1 " / " $2, $4
}')

printf '%s\n' "$display_bindings" | rofi_menu "Keys" >/dev/null
