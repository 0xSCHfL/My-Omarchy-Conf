#!/usr/bin/env bash

ROFI_NAV='-kb-row-up "k,Up" -kb-row-down "j,Down" -kb-cancel "Escape,h,q"'
ROFI_THEME="$HOME/.config/rofi/dwm-keys.rasi"

rofi_menu() {
  eval rofi -dmenu -no-sort -i -theme "$ROFI_THEME" $ROFI_NAV -p "$1"
}

window_keys() { cat <<'EOF'
Super + Return       → Terminal (kitty)
Super + w            → Close window
Super + q            → qutebrowser
Super + f            → True fullscreen (bar hides)
Super + Alt + f      → Maximize (fills workspace, gaps + bar stay)
Super + h            → Focus left
Super + j            → Focus down
Super + k            → Focus up
Super + l            → Focus right
Super + Ctrl + h     → Split horizontal
Super + Ctrl + l     → Split vertical
Super + o            → Layout stacking
Super + e            → Toggle split layout
Super + t            → Toggle floating
Super + Shift + f    → Nautilus file manager
Super + Shift + space → Toggle floating
Super + a            → Focus parent
Super + r            → Resize mode
Super + Left/Down/Up/Right → Focus direction
Super + Shift + h/j/k/l → Move window left/down/up/right
EOF
}

workspace_keys() { cat <<'EOF'
Super + 1-0          → Switch to workspace
Super + Shift + 1-0  → Move window to workspace
Super + Ctrl + g     → Gaps mode
Super + Tab          → Cycle focus (alt-tab)
EOF
}

scratchpad_keys() { cat <<'EOF'
Super + s            → Move window to scratchpad
Super + Alt + s      → Show/hide scratchpad
EOF
}

apps_keys() { cat <<'EOF'
Super + Return       → Terminal (kitty)
Super + Space        → App launcher (rofi)
Super + q            → qutebrowser
Super + Shift + b    → Brave
Super + Shift + c    → Chromium
Super + Shift + o    → Obsidian
Super + Shift + t    → btop
Super + Shift + m    → Timer
Super + Shift + i    → Image picker
Super + Ctrl + t     → Veyon Master (classroom management)
Super + Alt + t      → Telegram
Super + Shift + v    → Image clipboard history (Space select, Ctrl+d deletes selected)
Super + Escape       → System menu
Super + Shift + w    → WhatsApp
Super + Shift + a    → ChatGPT
Super + Shift + x    → Twitter / X
Super + Shift + d    → Discord
Super + Shift + e    → Email picker (Gmail app window)
Super + Shift + n    → Neovim
Super + v            → Clipboard manager (Walker, Ctrl+d deletes)
Super + Ctrl + v     → Copyq show
Super + n            → Notes
Super + Ctrl + k     → Keybindings help
Super + Ctrl + e     → Emoji picker
Super + Ctrl + x     → Dictation toggle (transcribed text auto-types at cursor)
Super + Shift + g    → Google Drive TUI
Super + Shift + r    → Restart i3
Super + Ctrl + r     → Reload i3 config + run i3-dedup (heal/check daemons)
Super + x            → Lock screen (i3lock)
Super + Shift + q    → Exit i3
EOF
}

media_keys() { cat <<'EOF'
XF86AudioRaiseVol    → Volume up (popup)
XF86AudioLowerVol    → Volume down (popup)
XF86AudioMute        → Mute/unmute (popup)
XF86AudioMicMute     → Mute microphone
Brightness Up/Down   → Brightness +/- (Fn keys)
Print                → Screenshot → clipboard
Super + Print        → Screen recording (start/stop)
Super + Ctrl + Print → OCR screenshot → clipboard
Super + Shift + s    → Spotify
EOF
}

notification_keys() { cat <<'EOF'
Super + ,            → Dismiss last notification
Super + Shift + ,    → Dismiss all notifications
Super + Ctrl + ,     → Toggle notifications
EOF
}

wallpaper_keys() { cat <<'EOF'
Super + Ctrl + Space → Wallpaper picker (rofi)
--- Inside image picker (Super+Shift+i) ---
Alt + w              → Set as wallpaper (pywal)
EOF
}

while true; do
  CATEGORY=$(printf '%s\n' \
      '  Windows & navigation' \
      '  Workspaces' \
      '  Scratchpad' \
      '  Apps & launchers' \
      '  Media & volume' \
      '  Notifications' \
      '  Wallpaper' \
      | rofi_menu 'i3 Keybindings')

  [ -z "$CATEGORY" ] && break

  case "$CATEGORY" in
    *Windows*)   window_keys         | rofi_menu 'Windows' ;;
    *Workspace*) workspace_keys      | rofi_menu 'Workspaces' ;;
    *Scratch*)   scratchpad_keys     | rofi_menu 'Scratchpad' ;;
    *Apps*)      apps_keys           | rofi_menu 'Apps' ;;
    *Media*)     media_keys          | rofi_menu 'Media' ;;
    *Notif*)     notification_keys   | rofi_menu 'Notifications' ;;
    *Wallpaper*) wallpaper_keys       | rofi_menu 'Wallpaper' ;;
  esac
done
