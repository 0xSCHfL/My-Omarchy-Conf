#!/usr/bin/env python3

# Show a splash immediately while the slow textual import runs.
import sys as _sys
import shutil as _shutil
import atexit as _atexit

def _restore_terminal() -> None:
    _sys.stdout.write("\033[0m\033[?25h")
    _sys.stdout.flush()

_atexit.register(_restore_terminal)

_LOGO_LINES = [
    "█████████████▄  ███████████   ████       ████▄████     ████   █████████    ███  ███████████",
    "████ ▄▄▄▄▄▄▄▄█████▄ ▄▄▄▄▄████▄█████      ██████████    ████ ████ ▄▄▄▄████▄ ███  ████  ▄▄▄███▄▄",
    "█████████████▄█████      ██████████      ██████████████████ ██████████████ ███  ███████████ ▄█",
    "         ██████████      ██████████      ██████████    ████ ████     █████ ███  ████     ███ █",
    "██████████████ ▀███████████ ▀▀ ▀███████████ ▀▀█████    ████ ████     █████ ███  ███████████ ▀▀",
]
_LOGO_W = max(len(s) for s in _LOGO_LINES)
_SUBTITLE = "󰊫  Loading Google Drive…"

_cols, _rows = _shutil.get_terminal_size((100, 30))
_top = max(1, (_rows - (len(_LOGO_LINES) + 2)) // 2)
_left = max(0, (_cols - _LOGO_W) // 2)
_sub_left = max(0, (_cols - len(_SUBTITLE)) // 2)

_pad = " " * _left
_lines = [f"\033[{_top + i + 1};1H{_pad}{l}" for i, l in enumerate(_LOGO_LINES)]
_sub_line = f"\033[{_top + len(_LOGO_LINES) + 2};1H{' ' * _sub_left}\033[38;5;245m{_SUBTITLE}\033[0m"

_sys.stdout.write("\033[0m\033[?25l\033[2J\033[H\033[1;38;5;180m" + "".join(_lines) + "\033[0m" + _sub_line)
_sys.stdout.flush()

