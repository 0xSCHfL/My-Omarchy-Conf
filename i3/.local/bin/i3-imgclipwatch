#!/bin/bash
# Watches the clipboard for images, saves them to ~/.cache/hist, and re-persists them.
# Polling is more reliable than clipnotify for image clipboard owners that exit quickly.

HIST_DIR="$HOME/.cache/hist"
LOGFILE="/tmp/i3-imgclipwatch.log"
LOCK_PATH="${CLIPHIST_LOCK_PATH:-$HOME/.cache/cliphist/.lock}"
mkdir -p "$HIST_DIR"

store_clipboard() {
    local value="$1"
    mkdir -p "$(dirname "$LOCK_PATH")"
    {
        flock -x 9
        printf '%s\n' "$value" | cliphist store
    } 9>"$LOCK_PATH"
}

prev_checksum=""

while :; do
    targets=$(xclip -selection clipboard -t TARGETS -o 2>/dev/null || true)
    mime=""
    ext=""

    for candidate in image/png image/jpeg image/webp image/bmp image/tiff; do
        if printf '%s\n' "$targets" | grep -qx "$candidate"; then
            mime="$candidate"
            case "$candidate" in
                image/png) ext="png" ;;
                image/jpeg) ext="jpg" ;;
                image/webp) ext="webp" ;;
                image/bmp) ext="bmp" ;;
                image/tiff) ext="tiff" ;;
            esac
            break
        fi
    done

    if [ -n "$mime" ]; then
        echo "[$(date)] Found $mime in clipboard" >> "$LOGFILE"
        TMPFILE=$(mktemp "/tmp/imgclip-XXXXXX.$ext")
        if xclip -selection clipboard -t "$mime" -o 2>/dev/null > "$TMPFILE" && [ -s "$TMPFILE" ]; then
            checksum=$(md5sum "$TMPFILE" | cut -d' ' -f1)
            echo "[$(date)] Checksum: $checksum (prev: $prev_checksum)" >> "$LOGFILE"
            if [ "$checksum" != "$prev_checksum" ]; then
                prev_checksum="$checksum"
                OUTFILE="$HIST_DIR/$(date +%Y-%m-%d_%H-%M-%S).$ext"
                mv "$TMPFILE" "$OUTFILE"
                echo "[$(date)] Saved to $OUTFILE" >> "$LOGFILE"
                store_clipboard "__I3_IMAGE__:$OUTFILE"
                pkill -f "xclip -selection clipboard -loops" 2>/dev/null || true
                xclip -selection clipboard -t "$mime" -loops 0 < "$OUTFILE" &
            else
                echo "[$(date)] Duplicate, skipping" >> "$LOGFILE"
                rm -f "$TMPFILE"
            fi
        else
            echo "[$(date)] Failed to extract image from clipboard" >> "$LOGFILE"
            rm -f "$TMPFILE"
        fi
    fi

    sleep 1
done
