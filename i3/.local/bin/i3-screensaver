#!/bin/bash

SCREENSAVER_TEXT="$HOME/.config/i3/screensaver.txt"
[[ ! -f "$SCREENSAVER_TEXT" ]] && SCREENSAVER_TEXT="$HOME/.local/share/omarchy/logo.txt"

exit_screensaver() {
    pkill -x tte 2>/dev/null
    exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'

while true; do
    tte -i "$SCREENSAVER_TEXT" \
        --frame-rate 120 --canvas-width 0 --canvas-height 0 \
        --reuse-canvas --anchor-canvas c --anchor-text c \
        --random-effect --no-eol --no-restore-cursor &

    while pgrep -x tte >/dev/null; do
        if read -rsn1 -t 1; then
            exit_screensaver
        fi
    done
done
