#!/bin/bash
# Text clipboard history picker (fzf, with preview pane)

list_text() {
    cliphist list | awk -F'\t' '$2 !~ /PNG.*IDAT|JPEG|GIF8|RIFF.*WEBP|^\[\[ binary/'
}
export -f list_text

PREVIEW='
decoded=$(cliphist decode <<< {} 2>/dev/null)
if LC_ALL=C grep -q "[^[:print:][:space:]]" <<< "$decoded"; then
    echo "(binary data)"
else
    echo "$decoded"
fi'

selected=$(list_text | fzf \
    --prompt "Clipboard: " \
    --layout reverse \
    --no-sort \
    --preview "$PREVIEW" \
    --preview-window "right:40%:wrap" \
    --bind "ctrl-j:down" \
    --bind "ctrl-k:up" \
    --bind "ctrl-d:execute-silent(i3-cliphist-delete {})+reload(list_text)" \
    --header "enter:copy  ctrl-d:delete  esc:quit")

[ -n "$selected" ] && cliphist decode <<< "$selected" | xclip -selection clipboard
